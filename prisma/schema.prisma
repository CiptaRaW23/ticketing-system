generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  customer
  technician
  admin
}

enum UserStatus {
  active
  inactive
}

enum TicketStatus {
  open          // Customer buat ticket, belum ditangani
  assigned      // Admin sudah assign ke teknisi, menunggu acc
  in_progress   // Teknisi sudah acc, sedang dikerjakan
  closed        // Selesai
}

enum AssignmentStatus {
  pending   // Menunggu konfirmasi teknisi
  accepted  // Teknisi acc
  rejected  // Teknisi reject → ticket kembali open
}

enum TicketPriority {
  low
  medium
  high
}

enum MessageSender {
  customer
  admin
  bot
}

// ==================== USER ====================

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique @db.VarChar(50)
  fcmToken    String?
  name        String     @db.VarChar(100)
  email       String?    @unique @db.VarChar(100)
  phone       String?    @db.VarChar(20)
  password    String     @db.VarChar(255)
  role        UserRole   @default(customer)
  status      UserStatus @default(active)
  address     String?    @db.Text
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relasi customer: tiket yang dibuat
  tickets               Ticket[]           @relation("CustomerTickets")

  // Relasi admin: tiket yang di-assign oleh admin ini
  assignedTickets       Ticket[]           @relation("AssignedToAdmin")

  // Relasi teknisi: tiket yang sedang ditangani
  currentTickets        Ticket[]           @relation("CurrentTechnician")

  // Relasi teknisi: riwayat assignment
  technicianAssignments TicketAssignment[] @relation("AssignedTechnician")

  // Relasi teknisi: jadwal kunjungan
  visitSchedules        VisitSchedule[]    @relation("TechnicianSchedules")

  // Relasi teknisi: foto yang diupload
  uploadedPhotos        TicketPhoto[]      @relation("PhotoUploader")

  @@map("users")
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([username])
}

// ==================== TICKET ====================

model Ticket {
  id           Int             @id @default(autoincrement())
  ticketNumber String          @unique
  title        String          @db.VarChar(200)
  description  String          @db.Text
  status       TicketStatus    @default(open)
  priority     TicketPriority?

  // Lokasi customer
  address      String?         @db.Text
  mapsLink     String?         @db.VarChar(500)

  // Customer yang buat ticket
  userId       Int
  user         User            @relation("CustomerTickets", fields: [userId], references: [id], onDelete: Cascade)

  // Admin yang melakukan assign
  assignedToId Int?
  assignedTo   User?           @relation("AssignedToAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  // Teknisi yang sedang aktif handle ticket ini
  // Diisi saat admin assign, dikosongkan jika teknisi reject
  currentTechnicianId Int?
  currentTechnician   User?  @relation("CurrentTechnician", fields: [currentTechnicianId], references: [id], onDelete: SetNull)

  technicianDone     Boolean   @default(false)
  technicianDoneAt   DateTime?

  // Resolusi
  resolvedBy     String?   @db.VarChar(50)
  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relasi
  messages      ChatMessage[]
  assignments   TicketAssignment[]
  photos        TicketPhoto[]
  visitSchedule VisitSchedule?

  @@map("tickets")
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([currentTechnicianId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([ticketNumber])
}

// ==================== TICKET ASSIGNMENT ====================
// Setiap kali admin assign teknisi ke ticket dicatat di sini.
// Satu ticket bisa punya banyak assignment (jika teknisi reject, admin assign ulang).

model TicketAssignment {
  id           Int              @id @default(autoincrement())

  ticketId     Int
  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  technicianId Int
  technician   User             @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: Cascade)

  status       AssignmentStatus @default(pending)

  adminNote    String?          @db.Text
  rejectReason String?          @db.Text

  assignedAt   DateTime         @default(now())
  respondedAt  DateTime?

  @@map("ticket_assignments")
  @@index([ticketId])
  @@index([technicianId])
  @@index([status])
  @@index([assignedAt])
}

// ==================== VISIT SCHEDULE ====================
// Jadwal kunjungan teknisi ke lokasi customer.
// Satu ticket hanya punya satu jadwal aktif (@unique pada ticketId).

model VisitSchedule {
  id                Int      @id @default(autoincrement())

  ticketId          Int      @unique
  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  technicianId      Int
  technician        User     @relation("TechnicianSchedules", fields: [technicianId], references: [id], onDelete: Cascade)

  scheduledDate     DateTime
  estimatedDuration Int?     // Estimasi durasi dalam menit
  note              String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("visit_schedules")
  @@index([technicianId])
  @@index([scheduledDate])
}

// ==================== TICKET PHOTO ====================
// Foto bukti pengerjaan yang diupload teknisi (maks 5 per ticket).

model TicketPhoto {
  id           Int      @id @default(autoincrement())

  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  uploadedById Int
  uploadedBy   User     @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  url          String   @db.VarChar(500)
  mimeType     String   @db.VarChar(50)
  fileSize     Int
  caption      String?  @db.VarChar(300)

  createdAt    DateTime @default(now())

  @@map("ticket_photos")
  @@index([ticketId])
  @@index([uploadedById])
  @@index([createdAt])
}

// ==================== CHAT MESSAGE ====================

model ChatMessage {
  id        Int           @id @default(autoincrement())

  ticketId  Int
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  sender    MessageSender
  message   String        @db.Text
  isRead    Boolean       @default(false)
  readAt    DateTime?

  createdAt DateTime      @default(now())

  @@map("chat_messages")
  @@index([ticketId])
  @@index([sender])
  @@index([createdAt])
  @@index([isRead])
}

// ==================== CUSTOMER REGISTRY ====================
model CustomerRegistry {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  address      String?   @db.Text
  isUsed       Boolean   @default(false)
  note         String?   @db.Text
  importedAt   DateTime  @default(now())
  usedAt       DateTime?
  usedByUserId Int?

  @@map("customer_registry")
  @@index([phone])
  @@index([isUsed])
  @@index([importedAt])
}
